<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DapperCode.Core.Tests</RootNamespace>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- MSTest requires public test classes, and test continuations intentionally use its context. -->
    <NoWarn>$(NoWarn);CA1515;CA1861;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\DapperCode.Windows\Services\NativeMethods.cs"
             Link="Interop\NativeMethods.cs" />
    <PackageReference Include="NSubstitute" />
    <ProjectReference Include="..\..\src\DapperCode.Core\DapperCode.Core.csproj" />
    <ProjectReference Include="..\DapperCode.ProcessFixture\DapperCode.ProcessFixture.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>
