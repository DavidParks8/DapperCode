<Window
    x:Class="DapperCode.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DapperCode.Windows"
    xmlns:models="using:DapperCode.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
      THESIS: A quiet Windows control surface keeps the private broker legible and recoverable; it refuses a web-dashboard shell.
      OWN-WORLD: Native Mica, system Segoe UI, Fluent controls, theme resources, and Windows spacing carry every state.
      STORY: Choose a workspace and installed agent, start the broker, pair a phone, then manage it without leaving the tray.
      FIRST VIEWPORT: Native title bar, direct status, one setup or dashboard flow, and the current lifecycle action at the end.
      FORM: Tray-first management window, inherited Windows 11 convention; standard system staging with no custom theme.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,144,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Width="24"
                Height="24"
                Source="Assets/Square44x44Logo.png"
                Stretch="Uniform"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="DapperCode" />
            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="7">
                <FontIcon
                    x:Name="TitleStatusIcon"
                    FontSize="12"
                    Glyph="&#xE946;"
                    IsHitTestVisible="False" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Snapshot.Headline, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ProgressBar
            x:Name="BusyProgress"
            Grid.Row="1"
            Height="2"
            IsIndeterminate="True"
            Visibility="Collapsed"
            AutomationProperties.Name="DapperCode is working" />

        <ScrollViewer
            x:Name="SurfaceScroller"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="Surface"
                MaxWidth="820"
                Padding="32,24,32,40"
                HorizontalAlignment="Center">

                <StackPanel x:Name="SetupPanel" Spacing="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left" Spacing="8">
                        <TextBlock
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Connect this PC to DapperCode"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Register one installed ACP agent, choose the private network your phone uses, and start the local broker."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="The broker is authenticated private-network software. Never expose it directly to the public internet."
                        Severity="Informational"
                        Title="Keep this connection private" />

                    <StackPanel Spacing="10">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Workspace" />
                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="Folder this broker may access" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.Workspace, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    AccessKey="W"
                                    Command="{x:Bind ViewModel.ChooseWorkspaceCommand}"
                                    Content="Choose folder"
                                    AutomationProperties.HelpText="Open the Windows folder picker" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="ACP agent" />
                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Header="Agent ID"
                                        Text="{x:Bind ViewModel.AgentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.HelpText="Stable identifier used in the ACP manifest" />
                                    <TextBox
                                        Grid.Column="1"
                                        Header="Display name"
                                        Text="{x:Bind ViewModel.AgentDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        IsReadOnly="True"
                                        Header="Installed executable"
                                        PlaceholderText="Choose an installed ACP executable"
                                        Text="{x:Bind ViewModel.AgentExecutable, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="0,28,0,0"
                                        AccessKey="A"
                                        Command="{x:Bind ViewModel.ChooseAgentCommand}"
                                        Content="Choose agent"
                                        AutomationProperties.HelpText="Open the Windows file picker" />
                                </Grid>
                                <TextBox
                                    Header="Arguments"
                                    PlaceholderText="acp"
                                    Text="{x:Bind ViewModel.AgentArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.HelpText="Arguments passed directly to the selected executable" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Phone network" />
                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="14">
                                <ComboBox
                                    x:Name="NetworkModePicker"
                                    Header="Network"
                                    SelectedIndex="{x:Bind ViewModel.NetworkModeIndex, Mode=TwoWay}"
                                    AutomationProperties.HelpText="Choose the private network shared with your phone">
                                    <ComboBoxItem Content="Tailscale" />
                                    <ComboBoxItem Content="Local network" />
                                </ComboBox>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="HostTextBox"
                                        Header="This PC’s IPv4 address"
                                        PlaceholderText="Leave blank to detect automatically"
                                        Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Grid.Column="1"
                                        Header="Broker port"
                                        InputScope="Number"
                                        PlaceholderText="Allocate automatically"
                                        Text="{x:Bind ViewModel.BridgePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <Button
                            AccessKey="S"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.SetupCommand}"
                            Content="Set up DapperCode"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <TextBlock
                            MaxWidth="700"
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="After setup, the broker runs while DapperCode is open and stops when it quits. DapperCode stores settings in its Windows app-data folder, never in your repository. The broker credential is protected by the Windows credential vault when available."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="DashboardPanel" Spacing="20" Visibility="Collapsed">
                    <Border
                        Padding="22"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="DashboardStatusIcon"
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Top"
                                    FontSize="24"
                                    Glyph="&#xE946;"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.Snapshot.Headline, Mode=OneWay}"
                                        AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.Snapshot.Detail, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="DashboardMetricsGrid" ColumnSpacing="0" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Connected devices" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.Snapshot.ConnectedClients, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Padding="16,0" Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Agents ready" />
                                    <TextBlock FontSize="18" FontWeight="SemiBold">
                                        <Run Text="{x:Bind ViewModel.Snapshot.ReadyAgents, Mode=OneWay}" />
                                        <Run Text=" of " />
                                        <Run Text="{x:Bind ViewModel.Snapshot.TotalAgents, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Padding="16,0" Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Uptime" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.UptimeLabel, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Padding="16,0,0,0" Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Recent errors" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.Snapshot.RecentErrorCount, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="PairingSection" Spacing="10">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Pair a phone" />
                        <Border
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Padding="8"
                                    Background="White"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Image
                                        x:Name="PairingQrImage"
                                        Width="184"
                                        Height="184"
                                        Stretch="Uniform"
                                        AutomationProperties.Name="Broker pairing QR code" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Stretch" Spacing="12">
                                    <TextBlock
                                        Text="Scan with DapperCode on your phone. The QR contains this workspace’s private broker credential."
                                        TextWrapping="Wrap" />
                                    <TextBox
                                        IsReadOnly="True"
                                        Header="Broker URL"
                                        Text="{x:Bind ViewModel.Snapshot.BridgeUrl, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Command="{x:Bind ViewModel.CopyBridgeUrlCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <SymbolIcon Symbol="Link" />
                                                <TextBlock Text="Copy URL" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Command="{x:Bind ViewModel.CopyPairingDataCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <SymbolIcon Symbol="Copy" />
                                                <TextBlock Text="Copy pairing data" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="WorkspacesSection" Spacing="10">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Workspaces" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ListView
                                ItemsSource="{x:Bind ViewModel.Bridges, Mode=OneWay}"
                                IsItemClickEnabled="False"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BridgeSnapshot">
                                        <Grid Padding="14,10" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind WorkspaceName}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind Headline}" />
                                                    <Run Text=" · port " />
                                                    <Run Text="{x:Bind BridgePort}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Tag="{x:Bind}"
                                                Click="WorkspaceLogButton_Click"
                                                AutomationProperties.Name="Open workspace logs"
                                                ToolTipService.ToolTip="Open logs">
                                                <SymbolIcon Symbol="Document" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Every workspace uses the broker endpoint with its own credential. Isolated runtimes start only when a phone requests work."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="10" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.OpenLogsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="Document" />
                                        <TextBlock Text="Open logs" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Command="{x:Bind ViewModel.RevealConfigCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="Folder" />
                                        <TextBlock Text="Reveal config" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SecretBackendLabel, Mode=OneWay}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="The broker runs while DapperCode is open and stops when it quits."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="StartupMessageText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.StartupMessage, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="LaunchAtLoginToggle"
                                    Grid.Column="1"
                                    Header="Launch at sign-in"
                                    IsEnabled="{x:Bind ViewModel.LaunchAtLoginCanChange, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=OneWay}"
                                    Toggled="LaunchAtLoginToggle_Toggled" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <InfoBar
            x:Name="NoticeBar"
            Grid.Row="2"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False"
            Severity="Success"
            AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
