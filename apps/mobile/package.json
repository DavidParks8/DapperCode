{
  "name": "@dappercode/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "mermaid:prepare": "node scripts/prepare-mermaid-runtime.cjs",
    "mermaid:check": "node scripts/prepare-mermaid-runtime.cjs --check",
    "prestart": "npm run mermaid:prepare",
    "start": "node scripts/run-expo.cjs start",
    "preios": "npm run mermaid:prepare",
    "ios": "node scripts/run-expo.cjs run:ios",
    "preandroid": "npm run mermaid:prepare",
    "android": "node scripts/run-expo.cjs run:android",
    "prelint": "npm run mermaid:prepare",
    "lint": "eslint src widgets --ext .ts,.tsx --max-warnings=0 --cache --cache-strategy content --concurrency 4",
    "pretypecheck": "npm run mermaid:prepare",
    "typecheck": "node scripts/run-expo.cjs customize tsconfig.json && tsc --noEmit",
    "prebuild": "npm run mermaid:prepare",
    "build": "node scripts/run-expo.cjs export --platform all --output-dir dist",
    "pretest": "npm run mermaid:prepare",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --runInBand --coverage",
    "test:contract": "jest --runInBand src/bridge/ws/ws.test.ts src/bridge/agui/agUi.test.ts",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.57",
    "@expo/metro-runtime": "~57.0.7",
    "@expo/ui": "~57.0.11",
    "@expo/vector-icons": "15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-store-review": "~57.0.1",
    "expo-widgets": "~57.0.10",
    "jotai": "^2.20.2",
    "mermaid": "11.16.1",
    "prismjs": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "7.0.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/jsdom": "20.0.1",
    "@types/node": "^22.19.15",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "jsdom": "20.0.3",
    "react-test-renderer": "19.2.3",
    "resolve-from": "5.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@bridge/(.*)$": "<rootDir>/src/bridge/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@shell/(.*)$": "<rootDir>/src/shell/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/features/chat/styles/styles.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 86
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|expo-router|standard-navigation|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  }
}
