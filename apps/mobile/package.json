{
  "name": "@dappercode/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "reanimated": {
    "staticFeatureFlags": {
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  },
  "scripts": {
    "intelligence:prepare": "node scripts/prepare-code-intelligence.cjs",
    "intelligence:check": "pnpm run intelligence:prepare && node scripts/check-local-code-runtime.cjs",
    "runtime:prepare": "pnpm run mermaid:prepare && pnpm run intelligence:prepare",
    "mermaid:prepare": "node scripts/prepare-mermaid-runtime.cjs",
    "mermaid:check": "node scripts/prepare-mermaid-runtime.cjs --check",
    "prestart": "pnpm run runtime:prepare",
    "start": "expo start",
    "preios": "pnpm run runtime:prepare",
    "ios": "expo run:ios",
    "preandroid": "pnpm run runtime:prepare",
    "android": "expo run:android",
    "prelint": "pnpm run runtime:prepare",
    "lint": "eslint src modules/on-device-agent/tests --ext .ts,.tsx --max-warnings=0 --cache --cache-strategy content --concurrency 4",
    "pretypecheck": "pnpm run runtime:prepare",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "typecheck:native": "tsc --noEmit -p modules/on-device-agent/tests/tsconfig.json",
    "prebuild": "pnpm run runtime:prepare",
    "build": "expo export --platform all --output-dir dist",
    "pretest": "pnpm run runtime:prepare && node scripts/check-local-code-runtime.cjs",
    "test": "jest --passWithNoTests",
    "pretest:coverage": "pnpm run runtime:prepare && node scripts/check-local-code-runtime.cjs",
    "test:coverage": "jest --runInBand --coverage",
    "test:contract": "jest --runInBand src/bridge/ws/ws.test.ts src/bridge/agui/agUi.test.ts",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.4",
    "@babel/runtime": "^7.29.14",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-store-review": "~58.0.3",
    "jotai": "^3.0.2",
    "llama.rn": "0.13.0-rc.11",
    "mermaid": "12.3.0",
    "prettier": "3.10.1",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "7.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "babel-preset-expo": "58.0.25",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "jsdom": "31.0.1",
    "react-test-renderer": "19.3.0",
    "test-renderer": "1.3.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/modules/on-device-agent/(?:ios/)?build/"
    ],
    "moduleNameMapper": {
      "^@bridge/(.*)$": "<rootDir>/src/bridge/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@shell/(.*)$": "<rootDir>/src/shell/$1",
      "^react-native-drawer-layout$": "<rootDir>/src/shared/testing/drawerLayoutMock.tsx"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/features/chat/styles/styles.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 86
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(?:((jest-)?react-native|@react-native(-community)?)|expo(nent)?|expo-router|standard-navigation|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@exodus/bytes|bcp-47(?:-match)?|is-(?:alphabetical|alphanumerical|decimal)|parse5(?:-parser-stream)?|entities|jotai|yaml))"
    ]
  }
}
