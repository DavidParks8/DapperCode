{
  "expo": {
    "name": "DapperCode",
    "slug": "tethercode",
    "owner": "davidparks8s-team",
    "scheme": "dappercode",
    "version": "0.1.0",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.dappermagna.tethercode"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0C0F12"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.dappermagna.dappercode"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/favicon.png",
      "output": "single"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "experiments": {
      "reactCompiler": true,
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      "./plugins/withAndroidCleartextTraffic",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon-white.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C0F12"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DapperCode uses the camera to scan bridge pairing QR codes and capture photos you want to attach to a chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DapperCode uses your photo library so you can choose an image from your phone and attach it to a chat prompt or workflow sent to your own host bridge.",
          "cameraPermission": "DapperCode uses the camera to scan bridge pairing QR codes and capture photos you want to attach to a chat."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-web-browser",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "dc4bb45d-72cf-4c82-8fcd-f841b1ef6c71"
      }
    }
  }
}
