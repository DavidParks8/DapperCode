BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_PREVIEW_HOST=127.0.0.1
BRIDGE_PREVIEW_PORT=8788
BRIDGE_WORKDIR=/path/to/target/repo
# Bridge-owned state and mobile uploads. The desktop app points these at its central data directory;
# these development defaults keep everything beside the workspace.
BRIDGE_STATE_DIR=/path/to/target/repo/.dappercode
BRIDGE_ATTACHMENTS_DIR=/path/to/target/repo/.dappercode-attachments
# Exit when this process does. The desktop app sets it; leave it unset for development.
BRIDGE_OWNER_PID=
ACP_AGENT_MANIFEST=/path/to/target/repo/.dappercode/agents.json
ACP_AGENT_ROOTS=/path/to/target/repo/.dappercode/agents
ACP_INITIALIZE_TIMEOUT_MS=15000
BRIDGE_AUTH_TOKEN=change-me
BRIDGE_ALLOW_INSECURE_NO_AUTH=false
BRIDGE_NO_AUTH_ALLOWED_ORIGINS=
BRIDGE_ALLOW_QUERY_TOKEN_AUTH=true
BRIDGE_ALLOW_OUTSIDE_ROOT_CWD=true
BRIDGE_WS_MAX_FRAME_BYTES=33554432
BRIDGE_WS_MAX_MESSAGE_BYTES=33554432
BRIDGE_WS_PER_CLIENT_IN_FLIGHT=16
BRIDGE_WS_GLOBAL_IN_FLIGHT=128
